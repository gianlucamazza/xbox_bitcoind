# Bitcoin Core pin for xbox_bitcoind
# Source of truth for third_party/bitcoin checkout and MSVC baseline builds.
#
# Update procedure:
#   1. Pick a release tag from https://github.com/bitcoin/bitcoin/releases
#   2. git ls-remote --tags https://github.com/bitcoin/bitcoin.git 'vX.Y*'
#   3. Set TAG + COMMIT (peeled commit of the annotated tag: refs/tags/vX.Y^{})
#   4. ./scripts/fetch-bitcoin-core.sh
#   5. Re-run MSVC baseline on Windows; record results in docs/research/spikes/

TAG=v31.1
COMMIT=9be056a8a72b624dae9623b2f7bded92c2a21c91
REPO_URL=https://github.com/bitcoin/bitcoin.git

# Baseline product flags (console v1)
# Keep in sync with scripts/build-msvc-baseline.ps1 and scripts/build-linux-smoke.sh
BUILD_GUI=OFF
ENABLE_WALLET=OFF
WITH_ZMQ=OFF
ENABLE_IPC=OFF
BUILD_TESTS=ON
