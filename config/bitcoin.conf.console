# Draft defaults for Xbox Series S (UWP / Dev Mode) — not final until measured under bitcoind.
# Host app should place datadir under ApplicationData LocalFolder (e.g. LocalState\bitcoin).

# Pruned validating node (v1 target)
prune=550

# RPC for local UI / debugging (bind decided by host; keep off public interfaces)
server=1
rpcallowip=127.0.0.1
rpcbind=127.0.0.1

# Outbound-only P2P first (NAT / UWP listen may be flaky)
listen=0

# Conservative memory on Series S AppContainer (raise after Game-class measurements)
dbcache=256
maxmempool=50
maxconnections=8

# Avoid optional services until needed
upnp=0
natpmp=0
# blocksonly=0

# Logging: host may also tee to LocalState\bitcoind.log
printtoconsole=0
