# Console defaults for Xbox Series S (UWP / Dev Mode) — IBD / sync profile.
# Host places datadir under ApplicationData LocalFolder (LocalState\bitcoin).
# Prefer stock Bitcoin Core options only — no custom consensus / forks.
#
# Profile name: console | ibd
# Apply: ./scripts/apply-console-conf.sh
#        ./scripts/apply-console-conf.sh --profile console
# At tip / pre-LN: config/bitcoin.conf.tip → --profile tip
# See config/README.md · docs/pre-lightning.md · docs/ops.md
#
# Sync policy (Series S, 10 GiB RAM shared with OS/UI/other Dev apps):
#   - Raise dbcache / peers for IBD; re-measure WS at tip before going higher.
#   - Conf is copied only when LocalState\bitcoin\bitcoin.conf is missing on first start.
#     To re-apply: ./scripts/apply-console-conf.sh

# --- Pruned validating full node (standard bitcoind operator setup) ---
# 550 MiB is Core's practical minimum. Raise (e.g. 2000–5000) only if Dev
# storage allows — more buffer if the process is offline longer (pre-LN prep).
prune=550

# Local RPC for UI / tooling (cookie auth under datadir/.cookie).
# Keep loopback-only until you intentionally open LAN (security surface).
server=1
rpcallowip=127.0.0.1
rpcbind=127.0.0.1

# Outbound-only Bitcoin P2P (standard for NAT / constrained hosts).
# listen=1 is optional later and not required for validation or for CLN backend.
listen=0

# --- IBD / sync performance (stock Core knobs) ---
# dbcache: MiB of UTXO+LevelDB cache. Core default is 450; we used 256 early
# for safety. Series S mid-IBD WS was ~0.7–1.0 GiB at 256 → 512 is the
# primary IBD speed lever (fewer flushes). Try 1024 only if no concurrent
# heavy Dev apps (e.g. large xllama) and soft-stop still clean.
dbcache=512

# Peer slots for parallel block download. 8 was very conservative; 16 is still
# mild for outbound-only. Does not open inbound (listen=0).
maxconnections=16

# Mempool cap (MiB). Small is fine on prune + IBD; raise near tip if you watch
# unconfirmed traffic. Ignored effectively when blocksonly=1.
maxmempool=50

# During pure IBD, blocksonly skips mempool + tx relay (less CPU/RAM/bandwidth
# on non-block traffic). Disable via --profile tip before Lightning / full mempool.
blocksonly=1

# Avoid optional services until needed
upnp=0
natpmp=0

# Logging (host app may also tee to LocalState\bitcoind.log)
printtoconsole=0

# Not enabled (standard pruned node):
# txindex=1          # incompatible with prune; CLN does not require it
# blockfilterindex=1
# assumevalid=…      # Core ships a recent assumevalid; override only if you know why
