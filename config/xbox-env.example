# Xbox Device Portal credentials (Series S / X, Dev Mode)
#
# Preferred: reuse the xllama console env (no copy needed):
#   source ~/.config/xllama/xbox-env
#
# Or install a project-local file:
#   mkdir -p ~/.config/xbox_bitcoind
#   cp config/xbox-env.example ~/.config/xbox_bitcoind/xbox-env
#   $EDITOR ~/.config/xbox_bitcoind/xbox-env
#
# Never commit real passwords.
# Loaded by scripts/env.sh (also sets XBOX_BITCOIND_* package identity).

# LAN IP of the Series S (Device Portal).
# Off-LAN via a jump host (standard OpenSSH):
#   ssh -N -L 127.0.0.1:11443:<console-ip>:11443 <jump-host>
#   export XBOX_IP_OVERRIDE=127.0.0.1
export XBOX_IP=192.168.1.x
export XBOX_PORT=11443
export XBOX_USER=Xbox
export XBOX_PASS=change-me

# Optional: pin the Device Portal self-signed cert public key (base64 SHA-256).
# See scripts/env.sh xbox_curl_config for the openssl one-liner to compute it.
# export XBOX_PORTAL_PUBKEY=...

# Optional (usually leave unset; export in shell when needed):
# export XBOX_IP_OVERRIDE=127.0.0.1
# export XBOX_PORT_OVERRIDE=11443
# export XBB_SOFT_STOP_MAX_WAIT=300
# export XBB_STATE_DIR=$HOME/.local/state/xbox_bitcoind
# export XBB_ASSUME_TIP_HEIGHT=920000
# export XBOX_BITCOIND_APP_ID=GianlucaMazza.xboxbitcoind
# export XBOX_BITCOIND_APP_ENTRY=App
