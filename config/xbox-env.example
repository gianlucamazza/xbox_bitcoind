# Xbox Device Portal credentials (Series S / X, Dev Mode)
#
# Preferred: reuse the xllama console env (no copy needed):
#   source ~/.config/xllama/xbox-env
#
# Or install a project-local file:
#   mkdir -p ~/.config/xbox_bitcoind
#   cp config/xbox-env.example ~/.config/xbox_bitcoind/xbox-env
#   $EDITOR ~/.config/xbox_bitcoind/xbox-env
#
# Never commit real passwords.

# LAN IP of the Series S (Device Portal).
# Off-LAN via Odroid (standard OpenSSH):
#   ssh -N -L 127.0.0.1:11443:192.168.1.44:11443 odroid-ts
#   export XBOX_IP_OVERRIDE=127.0.0.1
export XBOX_IP=192.168.1.44
export XBOX_PORT=11443
export XBOX_USER=Xbox
export XBOX_PASS=change-me
