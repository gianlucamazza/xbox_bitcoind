+#if defined(WINAPI_FAMILY) && (WINAPI_FAMILY == WINAPI_FAMILY_APP)
+#ifndef XBB_UWP_CREATEFILE
+#define XBB_UWP_CREATEFILE
+static HANDLE XbbCreateFileW(LPCWSTR name, DWORD access, DWORD share, LPSECURITY_ATTRIBUTES sa,
+                             DWORD disp, DWORD flags, HANDLE tmpl) {
+  CREATEFILE2_EXTENDED_PARAMETERS ep = {};
+  ep.dwSize = sizeof(ep);
+  ep.dwFileAttributes = flags & 0x0000FFFF;
+  ep.dwFileFlags = flags & 0xFFF00000;
+  ep.dwSecurityQosFlags = 0;
+  ep.lpSecurityAttributes = sa;
+  ep.hTemplateFile = tmpl;
+  return CreateFile2(name, access, share, disp, &ep);
+}
+#define CreateFileW XbbCreateFileW
+#define MoveFileW(src, dst) MoveFileExW((src), (dst), MOVEFILE_REPLACE_EXISTING)
+#endif
