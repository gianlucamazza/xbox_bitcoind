diff --git a/src/util/subprocess.h b/src/util/subprocess.h
index 8b91713..cbb9a6f 100644
--- a/src/util/subprocess.h
+++ b/src/util/subprocess.h
@@ -73,6 +73,47 @@ extern "C" {
   #include <sys/types.h>
 }
 
+// UWP AppContainer: process-creation APIs are outside the app partition.
+// Stub AFTER windows.h so BOOL/HANDLE types exist. Do not redeclare
+// PROCESS_INFORMATION/STARTUPINFOW — UWP headers already provide them.
+#if defined(WIN32) && defined(WINAPI_FAMILY) && (WINAPI_FAMILY == WINAPI_FAMILY_APP)
+#ifndef HANDLE_FLAG_INHERIT
+#define HANDLE_FLAG_INHERIT 0x00000001
+#endif
+#ifndef STARTF_USESTDHANDLES
+#define STARTF_USESTDHANDLES 0x00000100
+#endif
+#ifndef CREATE_UNICODE_ENVIRONMENT
+#define CREATE_UNICODE_ENVIRONMENT 0x00000400
+#endif
+#ifndef CREATE_NO_WINDOW
+#define CREATE_NO_WINDOW 0x08000000
+#endif
+static inline BOOL WINAPI XbbCreateProcessW(
+    LPCWSTR, LPWSTR, LPSECURITY_ATTRIBUTES, LPSECURITY_ATTRIBUTES, BOOL, DWORD,
+    LPVOID, LPCWSTR, LPSTARTUPINFOW, LPPROCESS_INFORMATION)
+{
+  SetLastError(ERROR_NOT_SUPPORTED);
+  return FALSE;
+}
+#define CreateProcessW XbbCreateProcessW
+static inline BOOL WINAPI XbbCreatePipe(PHANDLE hReadPipe, PHANDLE hWritePipe,
+                                        LPSECURITY_ATTRIBUTES, DWORD)
+{
+  if (hReadPipe) *hReadPipe = INVALID_HANDLE_VALUE;
+  if (hWritePipe) *hWritePipe = INVALID_HANDLE_VALUE;
+  SetLastError(ERROR_NOT_SUPPORTED);
+  return FALSE;
+}
+#define CreatePipe XbbCreatePipe
+static inline BOOL WINAPI XbbSetHandleInformation(HANDLE, DWORD, DWORD)
+{
+  SetLastError(ERROR_NOT_SUPPORTED);
+  return FALSE;
+}
+#define SetHandleInformation XbbSetHandleInformation
+#endif // WIN32 && WINAPI_FAMILY_APP
+
 // The Microsoft C++ compiler issues deprecation warnings
 // for the standard POSIX function names.
 // Its preferred implementations have a leading underscore.
